# ─────────────────────────────────────────────────────────
# Rissme Branding Site — Environment Variables
# Copy this file to .env and fill in your values.
# All browser-exposed vars MUST be prefixed with VITE_
# ─────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────
# Canonical URL (used for OG tags, sitemap, etc.)
VITE_SITE_URL=https://rissme.com

# ── Waitlist ─────────────────────────────────────────────
# POST endpoint that receives { email } and adds to your list.
# Works with Mailchimp, ConvertKit, Resend, or a custom API.
# Leave blank to keep the front-end demo mode (no real submission).
VITE_WAITLIST_API_URL=

# ── Analytics (optional) ─────────────────────────────────
# Google Analytics 4 Measurement ID  (e.g. G-XXXXXXXXXX)
VITE_GA_ID=

# ── Social handles (optional) ────────────────────────────
# Used by the footer social links.
VITE_INSTAGRAM=rissme.app
VITE_TIKTOK=rissme.app
