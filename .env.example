# ─────────────────────────────────────────────────────────
# Rissme Branding Site - Environment Variables
# Copy this file to .env and fill in your values.
# All browser-exposed vars MUST be prefixed with VITE_
# ─────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────
# Canonical URL (used for OG tags, sitemap, etc.)
VITE_SITE_URL=https://rissme.com

# ── Waitlist (server-side only - never prefix these with VITE_) ──────
# The frontend posts to /api/waitlist, handled by server/index.js.
# Get the API key from resend.com.
RESEND_API_KEY=
# Until you verify a custom domain in Resend, the sandbox sender can only
# deliver to this address - so new signups notify you here instead of
# emailing the subscriber directly.
WAITLIST_NOTIFY_EMAIL=
# Optional: only used if you set up a Resend Audience to also save contacts.
RESEND_AUDIENCE_ID=

# Port the Express server (npm run server) listens on.
PORT=3000

# ── Analytics (optional) ─────────────────────────────────
# Google Analytics 4 Measurement ID  (e.g. G-XXXXXXXXXX)
VITE_GA_ID=

# ── Social handles (optional) ────────────────────────────
# Used by the footer social links.
VITE_INSTAGRAM=rissme.app
VITE_TIKTOK=rissme.app
